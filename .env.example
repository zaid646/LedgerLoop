# =============================================================================
# ExpenseIQ — environment configuration
# Copy to `.env` (gitignored) and fill in. NEVER commit real secrets.
# =============================================================================

# --- LLM backend: self-hosted vLLM on a rented GPU (OpenAI-compatible) -------
# The user spins up a 4090, then exposes the endpoint. Point these at it.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=changeme
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# fallback model used by the self-healing harness when primary output is invalid
VLLM_FALLBACK_MODEL=Qwen/Qwen2.5-7B-Instruct
# hourly GPU rate (USD) for the active session -> used to compute cost/document
GPU_RATE_USD_HR=0

# --- Experiment tracking (Weights & Biases) ----------------------------------
WANDB_API_KEY=
WANDB_PROJECT=expenseiq
WANDB_ENTITY=

# --- Hugging Face (dataset downloads; optional for public datasets) -----------
HF_TOKEN=

# --- Observability (Langfuse, self-hosted via infra/docker-compose.yml) ------
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local
LANGFUSE_HOST=http://localhost:3000

# --- Datastores (infra/docker-compose.yml) -----------------------------------
POSTGRES_DSN=postgresql://expenseiq:expenseiq@localhost:5432/expenseiq
MONGO_URI=mongodb://localhost:27017
MONGO_DB=expenseiq
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=ExpenseIQ!123
# bundled OpenSearch runs with the security plugin disabled -> set true for a secured cluster
OPENSEARCH_USE_SECURITY=false
# embedding model for the vector channel (needs the `search` extra: uv sync --extra search)
EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Warehouse (Snowflake) — Phase 5 -----------------------------------------
SNOWFLAKE_ACCOUNT=ujsbcto-of02014
SNOWFLAKE_USER=ZAID646
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=EXPENSEIQ
SNOWFLAKE_SCHEMA=ANALYTICS
# Prefer a fresh PAT or key-pair. Do NOT reuse an exposed token.
SNOWFLAKE_TOKEN=
SNOWFLAKE_ROLE=ACCOUNTADMIN

# --- Service -----------------------------------------------------------------
AI_SERVICE_PORT=8080
LOG_LEVEL=info
# optional: outbound webhook for expense.routed / expense.decided events
WEBHOOK_URL=
